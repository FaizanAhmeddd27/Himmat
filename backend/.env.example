# ---- Backend environment (copy to backend/.env) ----
# NEVER put real API keys in this file — it is committed to git.
# Real keys go ONLY in backend/.env (gitignored).

# App
APP_NAME=HIMMAT
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000

# Database (leave empty for Phase-2 file-persisted store; fill for Supabase)
DATABASE_URL=

# Supabase
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# AI explanation layer (groq | none). Static hints always work with "none".
AI_PROVIDER=none
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# Observability (optional)
SENTRY_DSN=
